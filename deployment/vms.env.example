NODE_ENV=production
HOST=127.0.0.1
PORT=5016

# Use the existing PostgreSQL database connection for this deployment.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Generate a unique value on the VPS with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Bootstrap the initial super-admin account (password must be at least 12 characters)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
SUPERADMIN_NAME=VMS Super Admin

# Public HTTPS origin used for appointment registration links and QR passes
APP_BASE_URL=https://vms.time88.in

# MSG91; use approved Flow templates and DLT mappings before enabling SMS
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_REGISTRATION_LINK=
MSG91_TEMPLATE_SUBMISSION_CONFIRMATION=
MSG91_TEMPLATE_APPROVED=
MSG91_TEMPLATE_REJECTED=
MSG91_TEMPLATE_CANCELLED=
MSG91_TEMPLATE_RESCHEDULED=
MSG91_TEMPLATE_REMINDER=
MSG91_DLR_WEBHOOK_SECRET=
