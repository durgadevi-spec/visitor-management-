# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/vms

# Used to sign auth tokens - set this to a long random string in production
SESSION_SECRET=change-me

# Initial super-admin account; use a unique password of at least 12 characters
SUPERADMIN_EMAIL=durga@ctint.in
SUPERADMIN_PASSWORD=adminadmin123
SUPERADMIN_NAME=Durga

# Port the server listens on
PORT=5000

# Public application origin used in appointment registration and QR pass links
APP_BASE_URL=http://localhost:5000

# MSG91 SMS settings; create/approve templates and DLT mappings before enabling delivery
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_REGISTRATION_LINK=
MSG91_TEMPLATE_SUBMISSION_CONFIRMATION=
MSG91_TEMPLATE_APPROVED=
MSG91_TEMPLATE_REJECTED=
MSG91_TEMPLATE_CANCELLED=
MSG91_TEMPLATE_RESCHEDULED=
MSG91_TEMPLATE_REMINDER=
MSG91_DLR_WEBHOOK_SECRET=
